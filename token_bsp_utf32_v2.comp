#version 450
// Drop‑in replacement for token_bsp_utf.comp
// Preserves API: push constant `inputLength` is UTF-8 byte count.
// No global barriers or memoryBarrierBuffer calls are used.
// Expansion reserves dst slots via atomicAdd(utf32Count) so no global sync is required.
// Compaction uses per-slot status waits (spin) to ensure partner readiness.

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

// --- Buffers (bindings kept compatible with existing pipeline) ---
layout(std430, binding = 0) readonly buffer InputStream { uint input_utf8[]; };
layout(std430, binding = 1) coherent buffer DebugBuffer { uint debugOut[]; };   // expanded utf32 tokens
layout(std430, binding = 2) coherent buffer EncodedOut { uint encoded[]; };    // compacted output
layout(std430, binding = 3) coherent buffer LensBuf { uint lens[]; };
layout(std430, binding = 4) coherent buffer PosBuf  { uint pos[]; };
layout(std430, binding = 5) coherent buffer StatusBuf { int status[]; };

// Length/counters buffer (binding 6)
layout(std430, binding = 6) coherent buffer LengthBuf {
    uint utf32Count;        // incremented (atomicAdd) during expansion to reserve dst slots
    uint actualUtf32Length; // atomicMax updated during compaction
    uint writeLen;          // atomicAdd updated during compaction
};

// Push constants (preserve API)
layout(push_constant) uniform Params {
    uint inputLength; // UTF-8 byte count (input)
    uint maxTokens;   // optional safety bound (host may set)
} params;

const uint PAD_TOKEN = 0xFFFFFFFFu;

// Utility: round up x to multiple of g
uint roundUp(uint x, uint g) {
    return ((x + g - 1u) / g) * g;
}

// -----------------------------------------------------------------------------
// NOTE about writeRawByteExtend:
// Replace the body of writeRawByteExtend with your repo's exact decode logic.
// The function below demonstrates the reservation pattern: it reserves a dst
// index via atomicAdd(utf32Count, 1) and writes one token into debugOut[dst].
// If your decoder emits variable number of tokens per input byte, adapt the
// reservation logic accordingly (reserve N slots before writing).
// -----------------------------------------------------------------------------
void writeRawByteExtend_reserve_and_write(uint srcIdx) {
    // Reserve a destination slot in the expanded stream
    uint dst = atomicAdd(utf32Count, 1u);

    // --- Decode logic placeholder ---
    // The repo's original decode should produce one or more UTF-32 tokens.
    // If it produces exactly one token per src byte, write it here:
    //   uint token = decode_byte_to_utf32(input_utf8[srcIdx]);
    //   debugOut[dst] = token;
    //
    // If your decoder can emit multiple tokens for a single src byte,
    // reserve the required number of slots (atomicAdd) and write them.
    //
    // For now we use a simple 1:1 placeholder copy (byte -> token).
    debugOut[dst] = input_utf8[srcIdx];
    // ----------------------------------

    // mark this dst slot as ready
    atomicExchange(status[dst], 1);
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint totalThreads = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    uint groupSize = gl_WorkGroupSize.x;

    // Stage 1: Expansion (UTF-8 -> UTF-32)
    // Each thread iterates over input bytes and uses atomic reservation to write
    // expanded tokens into debugOut[]. utf32Count is incremented by the helper.
    for (uint src = tid; src < params.inputLength; src += totalThreads) {
        // Call the decode/reserve helper. Replace its body with the repo's decode.
        writeRawByteExtend_reserve_and_write(src);
    }

    // No global barrier here by design. Compaction will wait on per-slot status.

    // Read expanded length (number of emitted UTF-32 tokens)
    // Use atomicAdd with 0 to read current counter value.
    uint utf32Len = atomicAdd(utf32Count, 0u);

    // Compute padded length (round up to groupSize)
    uint utf32Padded = roundUp(utf32Len, groupSize);

    // Stage 2: Init per-thread: move debugOut -> encoded, set lens/pos/status
    // We iterate over padded range so compaction has even groups.
    for (uint idx = tid; idx < utf32Padded; idx += totalThreads) {
        if (idx < utf32Len) {
            // Wait until expansion wrote this slot (status may already be 1)
            while (atomicAdd(status[idx], 0) == 0) { }
            encoded[idx] = debugOut[idx];
            lens[idx]    = 1u;
        } else {
            // padding slot
            encoded[idx] = PAD_TOKEN;
            lens[idx]    = 0u;
            // mark padded slot ready
            atomicExchange(status[idx], 1);
        }
        pos[idx] = idx;
        // ensure status is set for real slots too (some may already be 1)
        atomicExchange(status[idx], 1);
    }

    // Initialize counters once (tid 0)
    if (tid == 0u) {
        // set actualUtf32Length to the current expanded length
        // and writeLen to the number of initial tokens written
        actualUtf32Length = utf32Len;
        writeLen = utf32Len;
    }

    // Stage 3: Compaction (stride-doubling). Leaders at (idx % (2*stride)) == stride
    // No global barriers; each leader waits on its partner via status spin.
    for (uint stride = 1u; stride < utf32Padded; stride <<= 1u) {
        for (uint idx = tid; idx < utf32Padded; idx += totalThreads) {
            // leader condition: offset by stride inside each 2*stride group
            if ((idx % (stride * 2u)) == stride) {
                uint partner = idx - stride;
                if (partner >= utf32Padded) continue;

                // wait until partner is ready
                while (atomicAdd(status[partner], 0) == 0) { }

                uint l_len = lens[idx];
                uint r_len = lens[partner];
                uint l_pos = pos[idx];
                uint r_pos = pos[partner];

                // append partner sequence into leader's region
                // note: if r_len == 0 (padding), loop is skipped
                for (uint j = 0u; j < r_len; ++j) {
                    encoded[l_pos + l_len + j] = encoded[r_pos + j];
                }

                uint newLen = l_len + r_len;
                lens[idx] = newLen;

                // update global counters
                atomicMax(actualUtf32Length, newLen);
                atomicAdd(writeLen, r_len);

                // mark leader ready for next rounds
                atomicExchange(status[idx], 1);
            }
        }
        // no barrier: next stride leaders will spin on their partners' status
    }

    // End: actualUtf32Length and writeLen contain final values.
    // Host should read them from LengthBuf after dispatch completes.
}
