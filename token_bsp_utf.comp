	debugOut[baseIndex + byteIndex * 4 + 2] = ((inputChar[0] & 0x0F) << 12) | ((inputChar[1] & 0x3F) << 6) | (inputChar[2] & 0x3F);
	debugOut[baseIndex + byteIndex * 4 + 3] = ((inputChar[0] & 0x07) << 18) | ((inputChar[1] & 0x3F) << 12) | 
								((inputChar[2] & 0x3F) << 6) | (inputChar[3] & 0x3F);

	encoded[baseIndex + byteIndex * 4 + 0] = debugOut[baseIndex + byteIndex * 4 + 0];
