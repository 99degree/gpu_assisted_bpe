// Main UTF-8 conversion function
void main_utf() {
    uint threadID = gl_GlobalInvocationID.x;

    // Each thread processes one or more characters
    for (uint charIndex = threadID; charIndex < inputLength; charIndex += gl_NumWorkGroups.x * gl_WorkGroupSize.x) {
        // Compute base index for writing to encoded buffer

        writeRawByte(charIndex);
        writeRawByte(charIndex + 1);
	writeRawByteExtend(charIndex);

//        return;
    }

//	return;

    // Synchronize threads before post-processing
    barrier();

    // Thread 0 performs final token extraction
    if (threadID == 0) {
	// pos index to encoded[]
	uint pos = 0; 
        uint firstWrite = atomicAdd(writeLen, 1);
        if (atomicAdd(writeLen, 0) == 0) return;

        // Iterate through encoded buffer and extract valid UTF-8 tokens
	// inputOffset and inputLength is assumed char idx
        for (uint inputOffset = 0; inputOffset < inputLength;) {
	    uint inputOffsetPos = inputOffset * 4 * 4;
            uint byteLen = utf_top_mapping[debugOut[inputOffsetPos] & 0xFF];

	    if (byteLen > 4 || byteLen == 0) {
		encoded[pos++] = 0xff000000 | (debugOut[inputOffsetPos] & 0xFF) | byteLen << 16;
		inputOffset++;
//		break;
		continue;
	    }

	    //utf_top_mapping is indicating the total length of a utf32 char
	    // which is started by 1
            uint encodedIndex = inputOffsetPos + byteLen - 1;

            // Bounds check to avoid overflow
            if ((byteLen > 0) && (encodedIndex < (inputLength * 4))) {
                uint outputChar = debugOut[encodedIndex];
		uint byteLen1 = utf_top_mapping[debugOut[inputOffset * 4 + byteLen * 4] & 0xFF];
		uint pos1;
		uint encodedIndex1 = (inputOffset + byteLen) * 4 * 4 + byteLen1;
                encoded[pos1 = pos++] = outputChar | 0xf0000000 | byteLen << 24;
		encoded[pos1+1] = 0xf0000000 | byteLen1 << 24 | debugOut[encodedIndex1];
            }

            inputOffset += byteLen;


//		break;
        }
    }
}

// Entry point
void main() {
    main_utf();
}
